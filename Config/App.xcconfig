#include? "Secrets.xcconfig"

INFOPLIST_FILE = Config/Info.plist
IPHONEOS_DEPLOYMENT_TARGET = 17.0
SWIFT_VERSION = 6.0
PRODUCT_BUNDLE_IDENTIFIER = com.carecompanion.txst
PRODUCT_NAME = CareCompanion
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = CareCompanion
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone = UIInterfaceOrientationPortrait
TARGETED_DEVICE_FAMILY = 1,2
CODE_SIGN_STYLE = Automatic
ENABLE_USER_SCRIPT_SANDBOXING = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
CODE_SIGN_ENTITLEMENTS = Config/CareCompanion.entitlements
INFOPLIST_KEY_NSHealthShareUsageDescription = CareCompanion needs access to your health data to sync steps, sleep, and heart rate for Maya's care dashboard. This helps family members understand daily activity patterns.
INFOPLIST_KEY_NSHealthUpdateUsageDescription = CareCompanion does not write health data.
INFOPLIST_KEY_UIBackgroundModes = processing fetch
