// Copy to Config/Secrets.xcconfig (git-ignored) and fill in values from Supabase → Project Settings → API.
// Host only, without "https://" — xcconfig treats "//" as a comment.
SUPABASE_HOST = your-project-ref.supabase.co
SUPABASE_ANON_KEY = your-publishable-key

// RevenueCat → Project Settings → API Keys → Apple App Store (public, "appl_..." for production
// or "test_..." while using RevenueCat's Test Store during development). See docs/REVENUECAT.md.
REVENUECAT_API_KEY = your-revenuecat-public-sdk-key
